# ============================================================
# Café con Historia — Variables de entorno
# Copia este archivo como .env y completa los valores.
# Nunca subas .env al repositorio.
# ============================================================

# --- Supabase (base de datos del pipeline) ---
SUPABASE_URL=https://TU_PROYECTO.supabase.co
SUPABASE_KEY=eyJ...  # anon key del proyecto

# --- Slack (notificaciones y alertas) ---
SLACK_TOKEN=xoxb-...       # token del bot
SLACK_CHANNEL=#contenido   # canal para posts aprobados
SLACK_CANAL_ERRORES=#errores
SLACK_CANAL_INFRA=#infraestructura

# --- Facebook Graph API ---
FB_PAGE_TOKEN=EAA...           # Page Access Token (expira cada ~60 días)
FB_PAGE_ID=TU_PAGE_ID          # ID numérico de la página
FB_TOKEN_EXPIRA=YYYY-MM-DD     # fecha de expiración del token
FB_TOKEN_AVISO_DIAS=5          # días de aviso antes de expirar

# --- Ollama (LLM local) ---
OLLAMA_ENDPOINT=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# --- OpenAI (generación de imágenes, opcional) ---
OPENAI_API_KEY=sk-proj-...
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=tts-1-hd
OPENAI_TTS_VOZ=onyx

# --- Feature flags ---
GENERAR_IMAGENES=false   # true | false — activa generación de imágenes con OpenAI
